# macOS System & Cache Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon\r\r

# macOS volume / network metadata
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows thumbnails
Thumbs.db
ehthumbs.db

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Editor / IDE artifacts
.vscode/
.idea/
*.swp
*.swo

# ============================================================
# Extension Packaging Rules
# Extensions MUST be stored directly as uncompressed folders
# containing manifest.json.
# Archives (*.zip, *.tar, etc.) are strictly disallowed.
# ============================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Ignore loose temporary and backup files
*.tmp
*.bak
*.log

# Explicitly ensure markdown docs and license are tracked
!*.md
!LICENSE
!.gitignore

# Explicitly allow GitHub Actions workflows & CI scripts
!/.github/
!/.github/**
