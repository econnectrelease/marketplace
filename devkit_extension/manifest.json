{
  "manifest_version": "1.0",
  "extension_id": "devkit_debug",
  "name": "E-Connect DevKit Simulator",
  "version": "1.3.0",
  "author": "E-Connect Team",
  "contributor": "ryzen30xx",
  "icon": "developer_board",
  "categories": ["system"],
  "description": "Tạo thiết bị mô phỏng để quan sát giao thức E-Connect. Tất cả thiết bị chia sẻ chung 1 cổng HTTP duy nhất (mặc định 18080) và được phân tách độc lập bằng slug /<device-id>/test trên IP LAN Hub.",
  "provider": {"key": "developer_toolkit", "display_name": "Developer Toolkit"},
  "package": {
    "runtime": "python",
    "entrypoint": "main.py",
    "hooks": {
      "validate_command": "on_validate_command",
      "execute_command": "on_execute_command",
      "probe_state": "on_probe_state",
      "device_updated": "on_device_updated",
      "device_deleted": "on_device_deleted"
    }
  },
  "device_schemas": [
    {
      "schema_id": "devkit_light",
      "device_type": "light",
      "name": "DevKit Light",
      "default_name": "DevKit Light",
      "description": "Simulator cho đèn RGB (chia sẻ chung cổng 18080).",
      "display": {
        "card_type": "light",
        "capabilities": ["power", "brightness", "rgb", "color_temperature"],
        "temperature_range": {"min": 1700, "max": 6500}
      },
      "config_schema": {
        "fields": []
      }
    },
    {
      "schema_id": "devkit_switch",
      "device_type": "switch",
      "name": "DevKit Switch",
      "default_name": "DevKit Switch",
      "description": "Simulator cho công tắc bật/tắt (chia sẻ chung cổng 18080).",
      "display": {
        "card_type": "switch",
        "capabilities": ["power"]
      },
      "config_schema": {
        "fields": []
      }
    },
    {
      "schema_id": "devkit_fan",
      "device_type": "fan",
      "name": "DevKit Fan",
      "default_name": "DevKit Fan",
      "description": "Simulator cho quạt với tốc độ (chia sẻ chung cổng 18080).",
      "display": {
        "card_type": "fan",
        "capabilities": ["power", "fan_speed"]
      },
      "config_schema": {
        "fields": []
      }
    },
    {
      "schema_id": "devkit_sensor",
      "device_type": "sensor",
      "name": "DevKit Sensor",
      "default_name": "DevKit Sensor",
      "description": "Simulator cho cảm biến giá trị (chia sẻ chung cổng 18080).",
      "display": {
        "card_type": "sensor",
        "capabilities": ["value"]
      },
      "config_schema": {
        "fields": []
      }
    }
  ]
}
